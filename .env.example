# Every value is optional. With nothing set, the tool runs fully offline
# with the built in mock drafter and needs no key.

# Where the SQLite state file lives.
CD_DB_PATH=.distiller/distiller.db

# Clustering.
CD_SIMILARITY_THRESHOLD=0.30
CD_MIN_OCCURRENCES=2
CD_MIN_DISTINCT_DATES=1

# Evidence gate. CD_MIN_CITATIONS cannot go below 1.
CD_MIN_CITATIONS=2
CD_MIN_QUOTE_CHARS=12
CD_MAX_RULE_CHARS=400

# Comma separated reviewers allowed to approve, reject and retire.
# Empty means any named reviewer other than the drafter.
CD_OWNERS=owner

# LLM step. "mock" (default, offline) or "http" (chat completions style endpoint).
CD_LLM_PROVIDER=mock
CD_LLM_BASE_URL=
CD_LLM_API_KEY=
CD_LLM_MODEL=
CD_LLM_TIMEOUT_SECONDS=30
